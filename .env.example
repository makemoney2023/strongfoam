# Supabase pooled application connection. Used by the Next.js server.
DATABASE_URL=
# Worker-compatible Supabase connection for pg-boss and long transactions.
# Local development falls back to DATABASE_URL. Production requires this value.
WORKER_DATABASE_URL=
# Direct Supabase connection for migrations and maintenance.
# Local development falls back to DATABASE_URL. Production requires this value.
DIRECT_URL=
# Render worker (`npm run worker`) uses WORKER_DATABASE_URL for pg-boss and the outbox.
WORKER_ID=
BLOB_READ_WRITE_TOKEN=
RESEND_API_KEY=
RESEND_FROM=
LEAD_NOTIFY_TO=estimating@strongfoam.com
LEAD_THANKS_SECRET=
NEXT_PUBLIC_CALENDLY_URL=
CALENDLY_WEBHOOK_SIGNING_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
OPS_SESSION_SECRET=
FIELD_SESSION_SECRET=
OPS_STAFF_EMAILS=
OPS_ADMIN_EMAILS=
OPS_STAFF_PASSWORD=
OPS_DEMO=
DEEPGRAM_API_KEY=
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
AI_DOCUMENT_MODEL=
# Commercial bid drafting. Unset keeps manual estimates and the deterministic demo draft.
AI_COMMERCIAL_MODEL=
# Rollout flags. Unset outside production keeps the current manual workflow available.
# In production, each flag must be 1 before that capability runs.
# Commercial AI also requires the scanner, residency approval, evaluation attestation,
# workflow-test attestation, cost and rate limits, and a worker heartbeat newer than 60 seconds.
COMMERCIAL_ESTIMATES_ENABLED=
BID_DOCUMENT_EXTRACTION_ENABLED=
COMMERCIAL_AI_ENABLED=
SIGNED_PROPOSALS_ENABLED=
ACCEPTED_ESTIMATE_CONVERSION_ENABLED=
COMMERCIAL_ORGANIZATION_IDS=
COMMERCIAL_FLAG_OVERRIDES=
COMMERCIAL_WORKFLOW_TESTS_PASSED=
COMMERCIAL_AI_EVALUATION_PASSED=
COMMERCIAL_DATA_RESIDENCY_APPROVED=
COMMERCIAL_AI_MONTHLY_COST_LIMIT_CENTS=
COMMERCIAL_AI_RATE_LIMIT_PER_HOUR=
COMMERCIAL_HEARTBEAT_ORGANIZATION_ID=
CLAMAV_HOST=
CLAMAV_PORT=
VOICE_RETENTION_DAYS=
VOICE_CONSENT_NOTICE=
